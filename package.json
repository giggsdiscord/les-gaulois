{
  "name": "les-gaulois-micro-etat",
  "version": "0.4.0",
  "private": true,
  "description": "Les Gaulois & Micro-État — simulation coopérative asynchrone (GDD V4.0). Moteur déterministe TypeScript + React + Supabase + GitHub Pages.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run engine:sync && vite",
    "build": "npm run engine:sync && tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.app.json",
    "check": "npm run engine:check && npm run typecheck && npm run test && npm run sql:check",
    "engine:sync": "node scripts/sync-engine.mjs",
    "engine:check": "node scripts/sync-engine.mjs --check",
    "functions:check": "node scripts/check-functions.mjs",
    "gdd:pdf": "node scripts/build-gdd-pdf.mjs",
    "sql:bundle": "node scripts/bundle-sql.mjs",
    "sql:check": "node scripts/check-sql.mjs",
    "deploy:check": "node scripts/check-deploy.mjs",
    "icons": "node scripts/build-icons.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@electric-sql/pglite": "^0.6.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "marked": "^18.0.0",
    "puppeteer-core": "^25.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0",
    "vite": "^8.4.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
