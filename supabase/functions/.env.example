# Secrets des Edge Functions (Supabase > Edge Functions > Secrets, ou `supabase secrets set --env-file`).
# SUPABASE_URL et SUPABASE_SERVICE_ROLE_KEY sont injectées automatiquement par Supabase.

# Clé de l'API Claude (console Anthropic). Vide = dictionnaire de secours déterministe (0 €).
ANTHROPIC_API_KEY=

# Modèle du Maître du Jeu. Défaut : claude-haiku-5-5 (moins de 1 $/mois pour 10-20 appels/jour).
# claude-opus-5-5 : récits plus riches, ~25-35 $/mois.
GM_MODEL=claude-haiku-5-5
# Effort de raisonnement : low (défaut), medium, high
GM_EFFORT=low
GM_TIMEOUT_MS=45000

# Secret partagé avec pg_cron (supabase/cron.sql). Générez une longue chaîne aléatoire.
CRON_SECRET=

# Origine autorisée (CORS), ex. https://monpseudo.github.io — « * » accepte tout.
ALLOWED_ORIGIN=*

# Facultatif : flux RSS (séparés par des virgules), position météo, fréquence des tentations
# RSS_FEEDS=https://feeds.elpais.com/mrss-s/pages/ep/site/elpais.com/portada,https://www.lemonde.fr/rss/une.xml
# WEATHER_LAT=42.33
# WEATHER_LON=1.33
# WEATHER_LABEL=Alt Urgell, Lleida
# TEMPTATION_CHANCE_PCT=20
